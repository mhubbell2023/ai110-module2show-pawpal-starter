classDiagram
    class Owner {
        +owner_id: str
        +name: str
        +available_time: int
        +preferences: list[str]
        +pets: list[Pet]

        +add_pet(pet: Pet) -> None
        +remove_pet(pet: Pet) -> None
        +get_pet(name: str) -> Pet | None
        +get_all_tasks(pet_name: str | None = None, completed: bool | None = None) -> list[Task]
    }

    class Pet {
        +pet_id: str
        +name: str
        +age: int
        +breed: str
        +care_tasks: list[Task]

        +add_task(task: Task) -> None
        +remove_task(task: Task) -> None
        +get_tasks() -> list[Task]
    }

    class Task {
        +task_id: str
        +name: str
        +duration: int
        +priority: str
        +completed: bool
        +scheduled_time: str
        +frequency: str
        +pet_name: str
        +next_occurrence: datetime | None

        +__post_init__() -> None
        +mark_complete() -> None
        +reset_status() -> None
        +create_next_occurrence() -> Task | None
    }

    class Scheduler {
        +generate_daily_schedule(owner: Owner) -> list[Task]
        +filter_tasks(tasks: list[Task], pet_name: str | None = None, completed: bool | None = None) -> list[Task]
        +sort_by_priority(tasks: list[Task]) -> list[Task]
        +sort_by_time(tasks: list[Task]) -> list[Task]
        +fit_available_time(tasks: list[Task], available_time: int) -> list[Task]
        +detect_overlaps(tasks: list[Task]) -> list[str]
        +explain_schedule(schedule: list[Task]) -> str
    }

    Owner "1" *-- "0..*" Pet
    Pet "1" *-- "0..*" Task
    Scheduler --> Owner
    Scheduler ..> Task
