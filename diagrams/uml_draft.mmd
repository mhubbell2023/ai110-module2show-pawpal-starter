classDiagram
    class Owner {
        +owner_id: str
        +name: str
        +available_time: int
        +preferences: list[str]
        +pets: list[Pet]

        +add_pet(pet: Pet) void
        +remove_pet(pet: Pet) void
        +get_pet(name: str) Pet
    }

    class Pet {
        +pet_id: str
        +name: str
        +age: int
        +breed: str
        +care_tasks: list[Task]

        +add_task(task: Task) void
        +remove_task(task: Task) void
        +get_tasks() list[Task]
    }

    class Task {
        +task_id: str
        +name: str
        +duration: int
        +priority: str
        +completed: bool

        +mark_complete() void
        +reset_status() void
    }

    class Scheduler {
        +generate_daily_schedule(owner: Owner) list[Task]
        +sort_by_priority(tasks: list[Task]) list[Task]
        +fit_available_time(tasks: list[Task], available_time: int) list[Task]
        +explain_schedule(schedule: list[Task]) str
    }

    Owner "1" *-- "0..*" Pet
    Pet "1" *-- "0..*" Task
    Scheduler --> Owner
    Scheduler ..> Task
